{
  "name": "trace-chain",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "npm run render:sound && npm run render:silent",
    "render:sound": "remotion render src/index.ts TraceChain out/trace-chain-sound.mp4",
    "render:silent": "remotion render src/index.ts TraceChain out/trace-chain-silent.mp4 --props='{\"sound\":false}' --muted",
    "still": "remotion still src/index.ts TraceChain"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/layout-utils": "4.0.534",
    "@remotion/media": "4.0.534",
    "@remotion/motion-blur": "4.0.534",
    "@remotion/noise": "4.0.534",
    "@remotion/paths": "4.0.534",
    "@remotion/shapes": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "@remotion/zod-types": "4.0.534",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
